# 🤖 TRADING BOT CONFIGURATION

# 🔗 Binance API (للـ REAL mode فقط، تركها فارغة للـ PAPER)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 📲 Telegram Bot Notifications
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 🎯 Trading Mode
MODE=LIVE_PAPER                    # LIVE_PAPER (تجريبي) أو REAL (حقيقي)
TRADING_TYPE=futures               # spot أو futures
LEVERAGE=5                          # 1-125x (futures فقط)

# 📊 Trailing & P&L Management
MIN_CONFIDENCE=10                  # الحد الأدنى لفتح صفقة
DATA_RETENTION_DAYS=20             # احتفظ بـ آخر كم يوم من البيانات (Data older than this will be deleted)

# 🔥 Trend Following Exit Philosophy
USE_UNLIMITED_PROFIT=true          # لا تغلق على TP ثابت، خلّي الأرباح تجري
ENABLE_FIXED_TAKE_PROFIT=false     # عطّل الخروج على هدف ثابت

# 🔥 NEW: Aggressive Database Cleanup
# ✅ يحفظ الأنماط الناجحة فقط (profit > 2%)
# ✅ يحذف التحليلات والصفقات الخاسرة كل 3 دقائق
# ✅ يستخدم VACUUM لتحرير مساحة القرص

# Environment
NODE_ENV=production
